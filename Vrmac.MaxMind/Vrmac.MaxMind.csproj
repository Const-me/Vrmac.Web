<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IlcInstructionSet>avx2,vectort128</IlcInstructionSet>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>true</PublishTrimmed>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<TrimMode>Full</TrimMode>
		<StripSymbols>true</StripSymbols>
		<DebuggerSupport>false</DebuggerSupport>
		<IlcTrimMetadata>true</IlcTrimMetadata>
		<EnableDiagnostics>false</EnableDiagnostics>
		<StackTraceSupport>false</StackTraceSupport>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Transform\regionFromCountry.gz" />
		<EmbeddedResource Include="Transform\regionFromCountry.gz" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vrmac.GeoIP\Vrmac.GeoIP.csproj" />
	</ItemGroup>

</Project>